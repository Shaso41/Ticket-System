@model TicketSistemi.Models.Ticket

@{
    ViewData["Title"] = "Destek Talebi Detayı";
}

<style>
    .chat-card {
        border-radius: 20px;
        background: var(--card-bg);
        border: var(--card-border);
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.05);
    }
    
    .chat-header {
        border-bottom: 1px solid var(--footer-border);
        background: rgba(99, 102, 241, 0.03);
        border-top-left-radius: 20px;
        border-top-right-radius: 20px;
    }

    .chat-body {
        background-color: var(--bg-color);
        border-radius: 12px;
        padding: 24px;
        min-height: 300px;
        display: flex;
        flex-direction: column;
        gap: 20px;
    }

    /* Chat bubble base */
    .bubble {
        max-width: 75%;
        padding: 16px 20px;
        border-radius: 20px;
        position: relative;
        line-height: 1.5;
        font-size: 0.95rem;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.02);
        animation: fadeIn 0.3s ease;
    }

    /* Left aligned bubble (Customer / User) */
    .bubble-left {
        align-self: flex-start;
        background-color: var(--card-bg);
        color: var(--text-color);
        border-top-left-radius: 4px;
        border: 1px solid var(--footer-border);
    }

    /* Right aligned bubble (Admin / Agent) */
    .bubble-right {
        align-self: flex-end;
        background: linear-gradient(135deg, #6366f1, #4f46e5);
        color: #ffffff;
        border-top-right-radius: 4px;
    }

    .bubble-meta {
        font-size: 0.75rem;
        margin-top: 8px;
        display: flex;
        align-items: center;
        gap: 6px;
    }

    .bubble-left .bubble-meta {
        color: #64748b;
    }

    .bubble-right .bubble-meta {
        color: rgba(255, 255, 255, 0.75);
    }

    .avatar {
        width: 32px;
        height: 32px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
        font-size: 0.85rem;
    }

    .avatar-user {
        background-color: #e0e7ff;
        color: #4f46e5;
    }

    .avatar-agent {
        background-color: #fef3c7;
        color: #d97706;
    }

    @@keyframes fadeIn {
        from { opacity: 0; transform: translateY(10px); }
        to { opacity: 1; transform: translateY(0); }
    }

    /* Timeline styles */
    .timeline {
        position: relative;
        padding-left: 20px;
        list-style: none;
        margin: 0;
    }
    
    .timeline::before {
        content: '';
        position: absolute;
        left: 5px;
        top: 5px;
        bottom: 5px;
        width: 2px;
        background-color: var(--footer-border);
    }
    
    .timeline-item {
        position: relative;
        margin-bottom: 25px;
        padding-left: 15px;
    }
    
    .timeline-item::before {
        content: '';
        position: absolute;
        left: -19px;
        top: 6px;
        width: 10px;
        height: 10px;
        border-radius: 50%;
        background-color: #cbd5e1;
        border: 2px solid var(--card-bg);
    }

    .timeline-item.completed::before {
        background-color: #10b981;
        box-shadow: 0 0 0 3px rgba(16, 185, 129, 0.15);
    }
    
    .timeline-item.active::before {
        background-color: #6366f1;
        box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.15);
    }

    .timeline-item:last-child {
        margin-bottom: 0;
    }
    
    .timeline-title {
        font-weight: 700;
        font-size: 0.9rem;
        margin-bottom: 2px;
    }
    
    .timeline-date {
        font-size: 0.75rem;
        color: var(--text-muted);
        margin-bottom: 4px;
    }
    
    .timeline-desc {
        font-size: 0.8rem;
        color: var(--text-color);
        opacity: 0.8;
    }
</style>

<div class="container py-3">
    <div class="mb-4">
        <a asp-action="Index" class="btn btn-outline-secondary btn-custom rounded-pill d-inline-flex align-items-center gap-2">
            <i class="bi bi-arrow-left"></i> Panele Geri Dön
        </a>
    </div>

    <div class="row g-4">
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="col-12">
                <div class="alert alert-danger alert-dismissible fade show rounded-3 shadow-sm border-0 mb-4" role="alert">
                    <div class="d-flex align-items-center">
                        <span class="fs-4 me-2"><i class="bi bi-exclamation-triangle-fill"></i></span>
                        <div><strong>Hata!</strong> @TempData["ErrorMessage"]</div>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            </div>
        }
        <div class="col-lg-8">
            <div class="card chat-card mb-4">
                <div class="chat-header p-4 d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
                    <div>
                        <div class="d-flex flex-wrap align-items-center gap-2 mb-1">
                            <span class="badge bg-primary rounded-pill">Talep #@Model.Id</span>
                            @if (Model.Status == TicketSistemi.Models.TicketStatus.Acik)
                            {
                                <span class="badge rounded-pill badge-acik px-3 py-1.5">Açık</span>
                            }
                            else if (Model.Status == TicketSistemi.Models.TicketStatus.Cozuldu)
                            {
                                <span class="badge rounded-pill badge-cozuldu px-3 py-1.5">Çözüldü</span>
                            }
                            else
                            {
                                <span class="badge rounded-pill badge-kapandi px-3 py-1.5">Kapandı</span>
                            }
                            <span class="badge bg-info text-dark rounded-pill px-3 py-1.5">@TicketSistemi.Models.EnumHelper.GetCategoryName(Model.Category)</span>
                            @if (Model.Priority == TicketSistemi.Models.TicketPriority.Yuksek)
                            {
                                <span class="badge bg-danger rounded-pill px-3 py-1.5">Yüksek Öncelik</span>
                            }
                            else if (Model.Priority == TicketSistemi.Models.TicketPriority.Orta)
                            {
                                <span class="badge bg-warning text-dark rounded-pill px-3 py-1.5">Orta Öncelik</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary rounded-pill px-3 py-1.5">Düşük Öncelik</span>
                            }
                        </div>
                        <h3 class="fw-bold mb-1 mt-2">@Model.Title</h3>
                        <p class="text-secondary mb-0 small">
                            <i class="bi bi-person-circle"></i> Müşteri: <strong>@Model.CustomerName</strong> | <i class="bi bi-calendar3"></i> Tarih: @Model.CreatedDate.ToTurkeyTime().ToString("dd MMMM yyyy HH:mm")
                        </p>
                    </div>
                    
                    <div class="text-md-end">
                        <span class="text-secondary d-block small mb-1">Üstlenen Temsilci</span>
                        @if (!string.IsNullOrEmpty(Model.AssignedAgent))
                        {
                            <span class="badge fw-semibold px-3 py-2 border rounded-pill" style="color: #4338ca; background-color: #e0e7ff; border: 1px solid #c7d2fe; font-size: 0.9rem;">
                                <i class="bi bi-person-circle"></i> @Model.AssignedAgent
                            </span>
                        }
                        else
                        {
                            <span class="text-muted small">Henüz Atanmadı</span>
                        }
                    </div>
                </div>

                <div class="card-body p-4">
                    <div class="chat-body" id="chatBody" style="max-height: 480px; overflow-y: auto; padding-right: 8px;">
                        <!-- İlk Açılış Mesajı (Talep Detayı) -->
                        @{
                            var isCreatorMe = string.Equals(Model.CustomerName, User.Identity?.Name, StringComparison.OrdinalIgnoreCase);
                        }
                        <div class="bubble @(isCreatorMe ? "bubble-right" : "bubble-left") mb-3">
                            <div class="d-flex align-items-center gap-2 mb-2 pb-1 border-bottom border-light border-opacity-10">
                                <div class="avatar avatar-user">
                                    @((Model.CustomerName ?? "M").Substring(0, Math.Min(2, (Model.CustomerName ?? "M").Length)).ToUpper())
                                </div>
                                <span class="fw-bold small @(isCreatorMe ? "text-white" : "")">
                                    @Model.CustomerName (Konu Sahibi)
                                </span>
                            </div>
                            <div style="word-break: break-word; line-height: 1.6;">@Html.Raw(Model.Description)</div>
                            
                            @if (!string.IsNullOrEmpty(Model.AttachmentPath))
                            {
                                <div class="mt-3 p-2 rounded border bg-light bg-opacity-10 d-flex flex-column gap-2" style="max-width: 320px;">
                                    @{
                                        var ext = System.IO.Path.GetExtension(Model.AttachmentPath).ToLowerInvariant();
                                        var isImage = ext == ".png" || ext == ".jpg" || ext == ".jpeg" || ext == ".gif" || ext == ".webp";
                                    }
                                    @if (isImage)
                                    {
                                        <a href="@Model.AttachmentPath" target="_blank" title="Görseli yeni sekmede aç">
                                            <img src="@Model.AttachmentPath" alt="@Model.AttachmentFileName" class="img-fluid rounded border shadow-sm" style="max-height: 200px; object-fit: contain;" />
                                        </a>
                                    }
                                    else
                                    {
                                        <div class="d-flex align-items-center gap-2">
                                            <span class="fs-4"><i class="bi bi-file-earmark-text"></i></span>
                                            <div class="overflow-hidden" style="max-width: 250px;">
                                                <span class="d-block text-truncate fw-semibold small @(isCreatorMe ? "text-white" : "")">@Model.AttachmentFileName</span>
                                                <a href="@Model.AttachmentPath" download class="btn btn-sm btn-light border py-1 px-2 mt-1" style="font-size: 0.75rem;">
                                                    <i class="bi bi-download"></i> Dosyayı İndir
                                                </a>
                                            </div>
                                        </div>
                                    }
                                </div>
                            }

                            <div class="bubble-meta justify-content-end">
                                <span>@Model.CreatedDate.ToTurkeyTime().ToString("dd MMM HH:mm")</span>
                            </div>
                        </div>

                        @if (Model.Messages != null && Model.Messages.Any())
                        {
                            @foreach (var msg in Model.Messages)
                            {
                                if (string.Equals(msg.Sender, "Sistem", StringComparison.OrdinalIgnoreCase))
                                {
                                    <div class="text-center my-3 w-100 align-self-center">
                                        <span class="badge bg-secondary bg-opacity-10 text-secondary border px-3 py-2 rounded-pill fw-normal" style="font-size: 0.85rem; letter-spacing: 0.2px; max-width: 90%; white-space: normal; display: inline-block; text-align: left;">
                                            @Html.Raw(msg.Message) <span class="text-muted ms-1 small">@msg.SentDate.ToTurkeyTime().ToString("dd MMM HH:mm")</span>
                                        </span>
                                    </div>
                                }
                                else
                                {
                                    var isMsgAdmin = string.Equals(msg.Role, "Admin", StringComparison.OrdinalIgnoreCase);
                                    var isMyMessage = string.Equals(msg.Sender, User.Identity?.Name, StringComparison.OrdinalIgnoreCase);
                                    <div class="bubble @(isMyMessage ? "bubble-right" : "bubble-left") mb-3">
                                        <div class="d-flex align-items-center gap-2 mb-2 pb-1 border-bottom border-light border-opacity-10">
                                            <div class="avatar @(isMsgAdmin ? "avatar-agent" : "avatar-user")">
                                                @((msg.Sender ?? "U").Substring(0, Math.Min(2, (msg.Sender ?? "U").Length)).ToUpper())
                                            </div>
                                            <span class="fw-bold small @(isMyMessage ? "text-white" : "")">
                                                @msg.Sender @(isMsgAdmin ? "(Destek Temsilcisi)" : "(Müşteri)")
                                            </span>
                                        </div>
                                        <div style="word-break: break-word; line-height: 1.6;">@Html.Raw(msg.Message)</div>
                                        
                                        @if (!string.IsNullOrEmpty(msg.AttachmentPath))
                                        {
                                            <div class="mt-3 p-2 rounded border bg-light bg-opacity-10 d-flex flex-column gap-2" style="max-width: 320px;">
                                                @{
                                                    var msgExt = System.IO.Path.GetExtension(msg.AttachmentPath).ToLowerInvariant();
                                                    var isMsgImage = msgExt == ".png" || msgExt == ".jpg" || msgExt == ".jpeg" || msgExt == ".gif" || msgExt == ".webp";
                                                }
                                                @if (isMsgImage)
                                                {
                                                    <a href="@msg.AttachmentPath" target="_blank" title="Görseli yeni sekmede aç">
                                                        <img src="@msg.AttachmentPath" alt="@msg.AttachmentFileName" class="img-fluid rounded border shadow-sm" style="max-height: 200px; object-fit: contain;" />
                                                    </a>
                                                }
                                                else
                                                {
                                                    <div class="d-flex align-items-center gap-2">
                                                        <span class="fs-4"><i class="bi bi-file-earmark-text"></i></span>
                                                        <div class="overflow-hidden" style="max-width: 250px;">
                                                            <span class="d-block text-truncate fw-semibold small @(isMyMessage ? "text-white" : "")">@msg.AttachmentFileName</span>
                                                            <a href="@msg.AttachmentPath" download class="btn btn-sm btn-light border py-1 px-2 mt-1" style="font-size: 0.75rem;">
                                                                <i class="bi bi-download"></i> Dosyayı İndir
                                                            </a>
                                                        </div>
                                                    </div>
                                                }
                                            </div>
                                        }

                                        <div class="bubble-meta justify-content-end">
                                            <span>@msg.SentDate.ToTurkeyTime().ToString("dd MMM HH:mm")</span>
                                        </div>
                                    </div>
                                }
                            }
                        }
                    </div>
                </div>
            </div>

            <div class="card chat-card" id="replyForm">
                <div class="card-header bg-transparent border-0 pt-4 px-4">
                    <h5 class="fw-bold mb-0">@(User.IsInRole("Admin") ? "Destek Talebini Yanıtla" : "Destek Ekibine Yazın")</h5>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Details" method="post" enctype="multipart/form-data">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.Id" />
                        
                        <div class="mb-3">
                             <label class="form-label fw-bold text-secondary">Mesajınız</label>
                             <input type="hidden" name="message" id="messageInput" />
                             <div id="editor-container" style="height: 180px; border-bottom-left-radius: 10px; border-bottom-right-radius: 10px; background-color: var(--input-bg); color: var(--input-color);">
                                  <textarea id="fallback-editor" class="form-control form-control-custom h-100 w-100" placeholder="Cevabınızı buraya yazabilirsiniz..." style="display: none; border: none; resize: none; outline: none; box-shadow: none;"></textarea>
                             </div>
                        </div>

                        <div class="mb-3">
                            <label for="attachment" class="form-label fw-bold text-secondary">Dosya Eki (Opsiyonel)</label>
                            <input type="file" name="attachment" id="attachment" class="form-control form-control-custom" accept=".pdf,.jpg,.jpeg,.png,.gif,.webp,.txt,.zip,.rar,.docx,.xlsx" />
                            <div class="form-text small text-muted">Desteklenen formatlar: Resim (PNG, JPG, GIF), PDF, TXT, ZIP vb. (Maks 10MB)</div>
                        </div>

                        @if (User.IsInRole("Admin"))
                        {
                            <div class="row g-3 mb-3">
                                <div class="col-md-6">
                                    <label for="category" class="form-label fw-bold text-secondary">Kategori Güncelle</label>
                                    <select name="category" id="category" class="form-select form-control-custom" style="cursor: pointer;">
                                        @foreach (var cat in Enum.GetValues<TicketSistemi.Models.TicketCategory>())
                                        {
                                            <!option value="@((int)cat)" @(Model.Category == cat ? "selected" : "")>@TicketSistemi.Models.EnumHelper.GetCategoryName(cat)</!option>
                                        }
                                    </select>
                                </div>
                                <div class="col-md-6">
                                    <label for="priority" class="form-label fw-bold text-secondary">Öncelik Güncelle</label>
                                    <select name="priority" id="priority" class="form-select form-control-custom" style="cursor: pointer;">
                                        @foreach (var pri in Enum.GetValues<TicketSistemi.Models.TicketPriority>())
                                        {
                                            <!option value="@((int)pri)" @(Model.Priority == pri ? "selected" : "")>@TicketSistemi.Models.EnumHelper.GetPriorityName(pri)</!option>
                                        }
                                    </select>
                                </div>
                            </div>
                        }

                        <div class="row align-items-center g-3">
                            @if (User.IsInRole("Admin"))
                            {
                                <div class="col-md-6 col-lg-5">
                                    <label for="status" class="form-label fw-bold text-secondary">Bilet Durumu Güncelle</label>
                                    <select name="status" id="status" class="form-select form-control-custom" style="cursor: pointer;">
                                        <option value="1" selected="@(Model.Status == TicketSistemi.Models.TicketStatus.Acik)">Açık</option>
                                        <option value="2" selected="@(Model.Status == TicketSistemi.Models.TicketStatus.Cozuldu)">Çözüldü</option>
                                        <option value="3" selected="@(Model.Status == TicketSistemi.Models.TicketStatus.Kapandi)">Kapandı</option>
                                    </select>
                                </div>
                                <div class="col-md-6 col-lg-7 text-md-end pt-md-4">
                                    <button type="submit" class="btn btn-custom btn-custom-primary shadow-sm">
                                        <i class="bi bi-send-fill"></i> Yanıtı Gönder ve Güncelle
                                    </button>
                                </div>
                            }
                            else
                            {
                                <div class="col-md-6 col-lg-5">
                                    <label for="status" class="form-label fw-bold text-secondary">Bilet Durumu</label>
                                    <select name="status" id="status" class="form-select form-control-custom" style="cursor: pointer;">
                                        <option value="1" selected="@(Model.Status == TicketSistemi.Models.TicketStatus.Acik)">Açık (İşlem Bekliyor)</option>
                                        <option value="3" selected="@(Model.Status == TicketSistemi.Models.TicketStatus.Kapandi)">Kapandı (Sorunum Çözüldü)</option>
                                    </select>
                                </div>
                                <div class="col-md-6 col-lg-7 text-md-end pt-md-4">
                                    <button type="submit" class="btn btn-custom btn-custom-primary shadow-sm">
                                        <i class="bi bi-send-fill"></i> Mesajı Gönder
                                    </button>
                                </div>
                            }
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card chat-card mb-4">
                <div class="card-header bg-transparent border-0 pt-4 px-4">
                    <h5 class="fw-bold mb-0"><i class="bi bi-clock-history"></i> Talep Geçmişi</h5>
                </div>
                <div class="card-body p-4">
                    <ul class="timeline">
                        <li class="timeline-item completed">
                            <div class="timeline-title">Talep Oluşturuldu</div>
                            <div class="timeline-date"><i class="bi bi-calendar3"></i> @Model.CreatedDate.ToTurkeyTime().ToString("dd MMM yyyy HH:mm")</div>
                            <div class="timeline-desc">Sorun kaydı @Model.CustomerName tarafından sisteme iletildi.</div>
                        </li>

                        @if (!string.IsNullOrEmpty(Model.AssignedAgent))
                        {
                            <li class="timeline-item completed">
                                <div class="timeline-title">Temsilci Atandı</div>
                                <div class="timeline-desc">Müşteri temsilcisi <strong>@Model.AssignedAgent</strong> bu talebi üstlendi.</div>
                            </li>
                        }
                        else
                        {
                            <li class="timeline-item active">
                                <div class="timeline-title">Atama Bekleniyor</div>
                                <div class="timeline-desc">Bir destek elemanının biletinizi üstlenmesi bekleniyor.</div>
                            </li>
                        }

                        @if (Model.Messages != null && Model.Messages.Any(m => string.Equals(m.Role, "Admin", StringComparison.OrdinalIgnoreCase)))
                        {
                            <li class="timeline-item completed">
                                <div class="timeline-title">Yanıt İletildi</div>
                                <div class="timeline-desc">Destek temsilcisi çözüm detaylarını içeren bir yanıt bıraktı.</div>
                            </li>
                        }
                        else if (!string.IsNullOrEmpty(Model.AssignedAgent))
                        {
                            <li class="timeline-item active">
                                <div class="timeline-title">İnceleme Aşamasında</div>
                                <div class="timeline-desc">Temsilci şu anda biletinizi inceliyor.</div>
                            </li>
                        }

                        @if (Model.Status == TicketSistemi.Models.TicketStatus.Cozuldu)
                        {
                            <li class="timeline-item completed">
                                <div class="timeline-title text-success"><i class="bi bi-check-circle-fill"></i> Çözüldü</div>
                                <div class="timeline-desc">Bu destek talebi başarıyla çözüldü olarak işaretlendi.</div>
                            </li>
                        }
                        else if (Model.Status == TicketSistemi.Models.TicketStatus.Kapandi)
                        {
                            <li class="timeline-item completed">
                                <div class="timeline-title text-secondary"><i class="bi bi-lock-fill"></i> Kapandı</div>
                                <div class="timeline-desc">Talep arşive alındı ve kapatıldı.</div>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <link href="https://cdn.quilljs.com/1.3.6/quill.snow.css" rel="stylesheet">
    <script src="https://cdn.quilljs.com/1.3.6/quill.js"></script>
    <style>
        .ql-toolbar.ql-snow {
            border-top-left-radius: 10px;
            border-top-right-radius: 10px;
            background-color: var(--input-bg);
            border-color: var(--input-border);
        }
        .ql-container.ql-snow {
            border-bottom-left-radius: 10px;
            border-bottom-right-radius: 10px;
            border-color: var(--input-border);
        }
        .ql-editor {
            color: var(--input-color);
            background-color: var(--input-bg);
            font-family: 'Outfit', sans-serif;
            font-size: 0.95rem;
        }
        .ql-editor.ql-blank::before {
            color: var(--text-muted) !important;
            font-style: normal;
        }
    </style>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            // Auto scroll chat body to the bottom
            const chatBody = document.getElementById("chatBody");
            if (chatBody) {
                chatBody.scrollTop = chatBody.scrollHeight;
            }

            // Listen to real-time ticket notification event for chat updates
            window.addEventListener("ticketNotification", function(e) {
                const ticketTitle = "@Html.Raw(Model.Title)";
                const currentUserId = '@(User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value ?? "")';
                
                // If it is targeted to a specific user, check if we are that user
                if (e.detail.targetRole === "User" && e.detail.targetUserId && e.detail.targetUserId.toString() !== currentUserId) {
                    return;
                }
                
                if (e.detail.message.includes(ticketTitle)) {
                    refreshChatBody();
                }
            });

            function refreshChatBody() {
                fetch(window.location.href)
                    .then(response => response.text())
                    .then(html => {
                        const parser = new DOMParser();
                        const doc = parser.parseFromString(html, 'text/html');
                        
                        // 1. Replace chat body
                        const newChatBody = doc.getElementById('chatBody');
                        const currentChatBody = document.getElementById('chatBody');
                        if (newChatBody && currentChatBody) {
                            currentChatBody.innerHTML = newChatBody.innerHTML;
                            // Auto scroll to bottom
                            currentChatBody.scrollTop = currentChatBody.scrollHeight;
                        }
                        
                        // 2. Replace timeline/history card if it exists
                        const newTimeline = doc.querySelector('.timeline');
                        const currentTimeline = document.querySelector('.timeline');
                        if (newTimeline && currentTimeline) {
                            currentTimeline.innerHTML = newTimeline.innerHTML;
                        }
                        
                        // 3. Update the ticket status badge in header if it changed
                        const statusBadgeSelector = '.chat-header .badge-acik, .chat-header .badge-cozuldu, .chat-header .badge-kapandi';
                        const newStatusBadge = doc.querySelector(statusBadgeSelector);
                        const currentStatusBadge = document.querySelector(statusBadgeSelector);
                        if (newStatusBadge && currentStatusBadge) {
                            currentStatusBadge.outerHTML = newStatusBadge.outerHTML;
                        }
                    })
                    .catch(err => console.error("Error refreshing chat:", err));
            }

            // Quill initialization with robustness / fallback
            let useQuill = false;
            let quill;
            if (typeof Quill !== 'undefined') {
                try {
                    quill = new Quill('#editor-container', {
                        theme: 'snow',
                        placeholder: 'Cevabınızı buraya yazabilirsiniz...',
                        modules: {
                            toolbar: [
                                ['bold', 'italic', 'underline', 'strike'],
                                [{ 'list': 'ordered'}, { 'list': 'bullet' }],
                                ['code-block', 'blockquote'],
                                ['clean']
                            ]
                        }
                    });
                    useQuill = true;
                } catch (e) {
                    console.error("Quill initialization failed, falling back to textarea:", e);
                }
            }

            if (!useQuill) {
                const fallback = document.getElementById('fallback-editor');
                if (fallback) {
                    fallback.style.display = 'block';
                    const container = document.getElementById('editor-container');
                    if (container) {
                        container.style.border = '1px solid var(--input-border)';
                        container.style.borderRadius = '10px';
                    }
                }
            }

            const statusSelect = document.getElementById("status");
            const categorySelect = document.getElementById("category");
            const prioritySelect = document.getElementById("priority");

            const initialStatus = statusSelect ? statusSelect.value : "";
            const initialCategory = categorySelect ? categorySelect.value : "";
            const initialPriority = prioritySelect ? prioritySelect.value : "";

            var form = document.querySelector('#replyForm form');
            form.onsubmit = function () {
                var messageInput = document.querySelector('#messageInput');
                var textContent = "";
                var htmlContent = "";

                if (useQuill && quill) {
                    htmlContent = quill.root.innerHTML;
                    textContent = quill.getText().trim();
                } else {
                    const fallback = document.getElementById('fallback-editor');
                    if (fallback) {
                        htmlContent = fallback.value.replace(/\n/g, '<br>');
                        textContent = fallback.value.trim();
                    }
                }
                
                var fileInput = document.querySelector('#attachment');
                var hasAttachment = fileInput && fileInput.files && fileInput.files.length > 0;
                
                const currentStatus = statusSelect ? statusSelect.value : "";
                const currentCategory = categorySelect ? categorySelect.value : "";
                const currentPriority = prioritySelect ? prioritySelect.value : "";
                
                const isMetadataChanged = (currentStatus !== initialStatus) || 
                                          (currentCategory !== initialCategory) || 
                                          (currentPriority !== initialPriority);

                if (textContent.length === 0 && !hasAttachment) {
                    messageInput.value = '';
                    if (!isMetadataChanged) {
                        alert('Lütfen bir mesaj yazın, bir dosya ekleyin ya da bilet bilgilerini güncelleyin.');
                        return false;
                    }
                } else {
                    messageInput.value = htmlContent;
                }
            };
        });
    </script>
}
